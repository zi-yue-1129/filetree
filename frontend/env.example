# Origin of the backend API (no trailing slash). Required for Cloudflare Pages
# builds; leave unset for local dev (the Vite proxy forwards /api to :5168).
VITE_API_BASE_URL=https://api.example.com

# Optional: iCloud link of a shared "FileNexus 上傳" shortcut. When set, /shortcut
# shows a one-tap install button (build the shortcut once, then Share → Copy iCloud Link).
# VITE_IOS_SHORTCUT_URL=https://www.icloud.com/shortcuts/xxxxxxxx
