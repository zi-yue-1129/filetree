# Origin of the backend API (no trailing slash). Required for Cloudflare Pages
# builds; leave unset for local dev (the Vite proxy forwards /api to :5168).
VITE_API_BASE_URL=https://api.example.com

# Public origin of the web frontend (no trailing slash needed).
# - Web builds: makes og:image absolute and adds og:url so LINE/Discord/Facebook
#   previews work. Optional for local dev / backend-served builds (index.html
#   keeps the relative og:image; share links use the page origin).
# - Capacitor / Tauri builds: REQUIRED. Share/folder links copied in the apps
#   point here (the WebView origin is https://localhost); without it copying a
#   link shows an error. Its host is also the Android App Links host.
# VITE_SITE_URL=https://www.example.com

# Optional: iCloud link of a shared "FileNexus 上傳" shortcut. When set, /shortcut
# shows a one-tap install button (build the shortcut once, then Share → Copy iCloud Link).
# VITE_IOS_SHORTCUT_URL=https://www.icloud.com/shortcuts/xxxxxxxx
