	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>cc.spkuan.filenexus.backup.processing</string>
		<string>cc.spkuan.filenexus.backup.refresh</string>
	</array>
